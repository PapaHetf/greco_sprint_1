    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Launch CryptoGuard",
            "program": "${workspaceFolder}/build/CryptoGuard",
            "args": [
                "-i",
                "big_file.txt",
                "-o",
                "lana_encrypt.txt",
                "-p",
                "1155",
                "--command",
                "encrypt"
            ],
            "cwd": "${workspaceFolder}/build"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Test",
            "program": "${workspaceFolder}/build/CryptoGuard_tests",
            "args": [],
            "cwd": "${workspaceFolder}/build"
        }
    ]
}